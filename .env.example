# ADMIN_PASSWORD: пароль скрытой админ-панели (открывается по адресу сайт/#admin).
# Обязателен — без него войти в панель нельзя. Используйте длинный, сложный пароль.
ADMIN_PASSWORD="придумайте-надёжный-пароль"

# GEMINI_API_KEY: ключ для ИИ-помощника (Google AI Studio подставляет его автоматически).
# Без ключа чат-бот отвечает заготовленным текстом.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL: модель Gemini (необязательно, по умолчанию gemini-flash-latest).
# GEMINI_MODEL="gemini-flash-latest"

# Уведомления о новых заявках и отзывах в Telegram (необязательно).
# 1) Создайте бота через @BotFather и получите токен.
# 2) Напишите боту любое сообщение, затем откройте
#    https://api.telegram.org/bot<ТОКЕН>/getUpdates и возьмите "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# DATA_DIR: папка для файла с заявками и отзывами (по умолчанию ./data).
# На хостинге укажите постоянный диск, иначе данные пропадут при перезапуске контейнера.
# DATA_DIR="/data"

# APP_URL: адрес сайта (AI Studio подставляет автоматически).
APP_URL="MY_APP_URL"
